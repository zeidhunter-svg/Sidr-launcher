    <string name="launcher_agent_step_open_battery_settings">Open battery settings</string>
    <string name="launcher_agent_step_open_data_usage_settings">Open data usage settings</string>
    <string name="launcher_agent_step_open_display_settings">Open display settings</string>
    <string name="launcher_agent_step_open_sound_settings">Open sound settings</string>
    <!-- A1″ Phase 3b, Task 4 (Slice C): two zero-argument navigating tools, then the one that takes
         an argument. launcher_agent_step_open_app_info DOES carry %1$s - it is the only one of the
