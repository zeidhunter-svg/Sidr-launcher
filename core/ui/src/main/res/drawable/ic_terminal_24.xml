<!--
  Terminal glyph (DS-11 A3, 2026-08-10). Replaces `Icons.Filled.Build` (a wrench) in SidrAppFooter,
  which read as "tools", not "terminal".

  Bundled as a local vector rather than pulling in `material-icons-extended` (several MB of
  dependency for a single glyph) — the same call already made for ic_mic_24 / ic_assistant_24.
  Shape follows the Material Design "terminal" icon (Apache 2.0, the same licence as the
  material-icons-core artifact this module already depends on): a window frame with a `>` prompt and
  a caret bar, drawn filled to match the two sibling glyphs and the Material Filled icons used
  elsewhere in the footer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      Four subpaths, nonZero fill: the window frame, the screen cut-out (wound opposite to the frame
      so it knocks through), then the `>` chevron and the caret bar, both of which sit inside the
      cut-out and therefore render solid again.
    -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M20,4H4C2.89,4 2,4.9 2,6v12c0,1.1 0.89,2 2,2h16c1.11,0 2,-0.9 2,-2V6C22,4.9 21.11,4 20,4zM20,18H4V8h16V18zM18,17h-6v-2h6V17zM7.5,17l-1.41,-1.41L8.67,13l-2.59,-2.59L7.5,9l4,4L7.5,17z" />
</vector>
