    <!-- Этап 4.0 (ADR 1/4) — the three mutually exclusive reasons understanding is unavailable.
         They replace the former blanket "Unknown command", which claimed the *command* was
         unrecognizable when the truth was about the *system*. Ordinary (not locked) vocabulary: the
         consent point for cloud routing is the Settings toggle, whose description IS Class B locked;
         these three are status lines about the current mode, not consent or data-handling claims. -->
    <string name="launcher_understanding_local_only">Not recognized locally. Cloud understanding is off.</string>
    <string name="launcher_understanding_needs_provider">No AI provider is set up yet.</string>
    <string name="launcher_understanding_provider_action">Set up provider</string>
    <string name="launcher_understanding_needs_network">Understanding this command needs a network connection.</string>

    <!-- Этап 4 / A0 Task 12 — the agent execution surface. Class A (ordinary UI), NOT the
         owner-signed Class B set in strings_locked.xml: the step gate is a risk confirmation, the
         same class as the AIL-5 confirm card, whose copy has always been Class A. Should the owner
         want the consent line owner-reviewed, that is a separate decision. -->
    <string name="launcher_agent_title">Agent</string>
    <string name="launcher_agent_running_title">Working on it</string>
    <string name="launcher_agent_step_launch">Open %1$s</string>
    <string name="launcher_agent_step_store">Find %1$s in the app store</string>
    <!-- Task 10 / A1': a step names its TOOL, not a launch. `launcher_agent_step_generic` is the
         fail-soft line for a registered tool this surface has no sentence for. -->
    <string name="launcher_agent_step_timer">Set a timer for %1$s</string>
    <string name="launcher_agent_step_settings">Open Android settings</string>
    <string name="launcher_agent_step_alarm">Set an alarm for %1$s</string>
    <!-- A1" Task 7: the first CONFIRM tool. Owner condition 2 (2026-09-18): the consent card must name
         BOTH the app label AND the package, because resolution is fuzzy and the human must see what
         will be removed before tapping Confirm. Closed by Task 11 - `PlanStep.line` reads `app_label`
         and `app` BY NAME for this tool id, rather than falling through to the single-literal path
         (which cannot render two values) or to the raw goal text. %1$s is the label the user said,
         %2$s is the package that will actually be removed. -->
    <string name="launcher_agent_step_uninstall">Remove %1$s (%2$s)</string>
    <!-- Task 9 / A1″ Phase 3a: the three launcher_memory tools. set_app_alias binds THREE literals
         (the resolved package, the label the user said, and the phrase), which the single-literal
         fallback path cannot render either. Task 11 closes it the same way as uninstall_app above:
         `PlanStep.line` reads `app_label` (falling back to `app`) and `phrase` BY NAME. %1$s is the
         name the user gave the app, %2$s is the phrase they coined for it. -->
    <string name="launcher_agent_step_set_alias">Call “%1$s” “%2$s”</string>
    <string name="launcher_agent_step_forget_alias">Forget the alias “%1$s”</string>
    <string name="launcher_agent_step_forget_choice">Forget the learned choice for “%1$s”</string>
    <string name="launcher_agent_step_generic">Run this step for %1$s</string>
    <!-- A1″ Phase 3b, Task 2 (Slice A): four zero-argument navigating tools. No placeholder, exactly
         like launcher_agent_step_settings above - the caller passes a subject the formatter ignores. -->
    <string name="launcher_agent_step_show_alarms">Show alarms</string>
    <string name="launcher_agent_step_open_camera">Open the camera</string>
    <string name="launcher_agent_step_open_wifi_settings">Open Wi-Fi settings</string>
    <string name="launcher_agent_step_open_bluetooth_settings">Open Bluetooth settings</string>
