    <string name="launcher_agent_step_open_location_settings">Open location settings</string>
    <string name="launcher_agent_step_open_notification_settings">Open notification settings</string>
    <string name="launcher_agent_step_open_app_info">App info for %1$s</string>
    <!-- A1″ Task 8: a tool whose NAME is data. %1$s is the app that published the shortcut and
         %2$s is the shortcut's own label; both are authored by that app, in whatever language it
         chose, and neither is ours to translate (measured: values-ru and values-tr labels arrive
         side by side in one list on the same device). The em dash between them is OURS, which is
         exactly why it lives here as part of the sentence rather than being concatenated in a
         ViewModel: a locale that wants different punctuation, or the two halves the other way
         round, changes this line and nothing else. -->
    <string name="launcher_agent_step_shortcut">Open “%1$s — %2$s”</string>
