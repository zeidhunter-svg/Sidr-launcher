{
  "permissions": {
    "allow": [
      "Bash(tools/gate.sh)",
      "Bash(tools/gate.sh *)",
      "Bash(./gradlew *)",
      "Bash(tools/device/pull-agent-db.sh)",
      "Bash(tools/device/pull-agent-db.sh *)",
      "Bash(codegraph *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(git branch --list *)",
      "Bash(git worktree list)",
      "Bash(git stash list)",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/claude/codegraph-prompt-hook.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/claude/guard-bash.sh\""
          }
        ]
      }
    ]
  }
}
